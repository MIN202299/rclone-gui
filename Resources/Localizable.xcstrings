            "value": "继续"
          }
        }
      }
    },
    "Copies new and changed files from the local folder to the remote folder. Nothing is ever deleted: files you delete locally stay on the remote, and the local folder is never changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把本地文件夹中新增和修改过的文件复制到远端文件夹。不会删除任何文件：本地删除的文件仍保留在远端，本地文件夹也不会被改动。"
          }
        }
      }
    },
    "Copies new and changed files from the remote folder to the local folder. Nothing is ever deleted: files deleted on the remote stay in the local folder, and the remote is never changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把远端文件夹中新增和修改过的文件复制到本地文件夹。不会删除任何文件：远端删除的文件仍保留在本地，远端也不会被改动。"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝"
          }
        }
      }
