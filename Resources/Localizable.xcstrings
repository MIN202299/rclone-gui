    "A backup task copies new and changed files between a local folder and a remote folder — once, on a schedule, or whenever local files change. It never deletes anything.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份任务会在本地文件夹和远端文件夹之间复制新增和修改过的文件，可以只运行一次、定时运行，或在本地文件变化时运行。它不会删除任何文件。"
          }
        }
      }
    },
    "A remote with this name already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名的远程存储。"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问"
          }
        }
      }
    },
    "Add Remote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加远程存储"
          }
        }
      }
    },
    "Add a Remote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加远程存储"
