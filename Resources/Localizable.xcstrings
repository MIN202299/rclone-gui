    "A remote with this name already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名的远程存储。"
          }
        }
      }
    },
    "A sync task keeps a local folder and a remote folder in step — once, on a schedule, or whenever local files change.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步任务让本地文件夹与远程文件夹保持一致——可以手动运行一次、按计划运行，或在本地文件变化时自动运行。"
          }
        }
      }
    },
    "Add Remote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加远程存储"
          }
        }
      }
    },
    "Add a Remote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加远程存储"
          }
        }
      }
    },
    "Add a cloud storage remote to get started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个云存储远程以开始使用。"
          }
        }
      }
    },
    "Already in sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已是最新"
          }
        }
      }
    },
    "Also sync when local files change": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件变化时也同步"
          }
        }
      }
    },
    "Automatic sync runs while Rclone is open, including when only its menu bar icon is showing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动同步在 Rclone 运行时进行，包括只显示菜单栏图标时。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退"
          }
        }
      }
    },
    "Cached copies of opened files will be deleted. Your files on the remotes are not affected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开文件的缓存副本将被删除。远程存储上的文件不受影响。"
          }
        }
      }
    },
    "Cached on this Mac — opens instantly": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已缓存在这台 Mac 上——可立即打开"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消"
          }
        }
      }
    },
    "Changes on either side, including deletions, are copied to the other side. If a file changed on both sides, the newer one wins and the other is kept with a numbered name. The first run merges both folders without deleting anything.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任一侧的更改（包括删除）都会同步到另一侧。如果同一文件在两侧都被修改，保留较新的版本，另一个以带编号的名称保留。首次运行会合并两个文件夹，不删除任何内容。"
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改…"
          }
        }
      }
    },
