    "Also encrypt file and folder names": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时加密文件名和文件夹名"
          }
        }
      }
    },
    "Automatic backups run while Rclone is open, including when only its menu bar icon is showing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动备份在 Rclone 打开时运行，只显示菜单栏图标时也会运行。"
          }
        }
      }
    },
