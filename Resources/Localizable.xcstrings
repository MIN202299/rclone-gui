    "Downloads %@ from rclone.org (about 33 MB), checks it against rclone's published checksum, and installs it for this app only. No administrator password needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 rclone.org 下载%@（约 33 MB），使用 rclone 公布的校验值验证，并仅为本应用安装。无需管理员密码。"
          }
        }
      }
    },
